{
  "name": "magnificent-sloth",
  "version": "1.0.0",
  "description": "Point of Sale for Dead Mongoose",
  "main": "main.js",
  "maintainers": [
    "commit"
  ],
  "scripts": {
    "start": "./node_modules/.bin/electron-rebuild && electron .",
    "build-semantic": "cd ./src/semantic && npx gulp build",
    "build-deb": "electron-packager . magnificent-sloth --platform=linux --arch=x64 --out dist --overwrite && electron-installer-debian --src dist/magnificent-sloth-linux-x64/ --dest dist/installers/ --arch amd64",
    "build": "cd ./src/semantic && npx gulp build && electron-builder"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.2.2",
    "electron-installer-debian": "^4.0.0",
    "electron-builder": "^26.18.0"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.9",
    "fomantic-ui": "^2.8.3",
    "global": "4.4.0",
    "jquery": "^4.0.0",
    "nfc-pcsc": "^0.8.0",
    "play-sound": "^1.1.6"
  }
}
